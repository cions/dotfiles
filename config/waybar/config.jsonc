{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 4,
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "group/system",
        "idle_inhibitor",
        "pulseaudio",
        "tray",
        "clock"
    ],
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", "-"],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "group/system": {
        "orientation": "inherit",
        "modules": [
            "cpu",
            "memory",
            "temperature",
            "network"
        ]
    },
    "cpu": {
        "format": "{usage}%CPU",
        "actions": {
            "on-scroll-up": "true",
            "on-scroll-down": "true"
        }
    },
    "memory": {
        "format": "{percentage}% ({used} GiB)",
        "tooltip": false,
        "actions": {
            "on-scroll-up": "true",
            "on-scroll-down": "true"
        }
    },
    "temperature": {
        "critical-threshold": 70,
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "format": "{temperatureC}°C",
        "format-critical": "{temperatureC}°C",
        "tooltip": false,
        "actions": {
            "on-scroll-up": "true",
            "on-scroll-down": "true"
        }
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-ethernet": "{ipaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected",
        "tooltip": false,
        "actions": {
            "on-scroll-up": "true",
            "on-scroll-down": "true"
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "🔒",
            "deactivated": "🔓"
        }
    },
    "pulseaudio": {
        "format": "{volume}% 🔊",
        "format-muted": "MUTED 🔇",
        "scroll-step": 5,
        "smooth-scrolling-threshold": 1.0,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "timezone": "Asia/Tokyo",
        "format": "{:%H:%M}",
        "format-alt": "{:%F %a %T}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "smooth-scrolling-threshold": 1.0,
        "calendar": {
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-down": "shift_up",
            "on-scroll-up": "shift_down"
        }
    }
}
